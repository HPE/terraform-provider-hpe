resource "hpe_morpheus_instance_type" "tf_example_instance_type" {
  name               = "{{.Name}}"
  code               = "{{.Code}}"
  description        = "{{.Description}}"
  labels             = {{.Labels}}
  category           = "{{.Category}}"
  visibility         = "{{.Visibility}}"
  image_path         = "{{.ImagePath}}"
  image_name         = "{{.ImageName}}"
  featured           = {{.Featured}}
  enable_deployments = {{.EnableDeployments}}
  enable_scaling     = {{.EnableScaling}}
  enable_settings    = {{.EnableSettings}}
  environment_prefix = "{{.EnvironmentPrefix}}"
  # option_type_ids    = {{.OptionTypeIds}}

  evar {
    name   = "{{.EvarFirstName}}"
    value  = "{{.EvarFirstValue}}"
    export = {{.EvarFirstExport}}
  }

  evar {
    name         = "{{.EvarSecondName}}"
    masked_value = "{{.EvarSecondMaskedValue}}"
    export       = {{.EvarSecondExport}}
  }
}
