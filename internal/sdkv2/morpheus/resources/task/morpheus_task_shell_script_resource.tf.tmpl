resource "hpe_morpheus_task_shell_script" "tfexample_shell_local" {
  name                = "{{.Name}}"
  code                = "{{.Code}}"
  labels              = {{.Labels}}
  source_type         = "{{.SourceType}}"
  script_content      = <<EOF
{{.ScriptContent}}
EOF
  sudo                = {{.Sudo}}
  retryable           = {{.Retryable}}
  retry_count         = {{.RetryCount}}
  retry_delay_seconds = {{.RetryDelaySeconds}}
  allow_custom_config = {{.AllowCustomConfig}}
}
