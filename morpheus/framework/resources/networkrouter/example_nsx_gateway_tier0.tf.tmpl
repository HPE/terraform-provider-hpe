resource "hpe_morpheus_network_router" "example" {
  name                   = "{{.Name}}"
  type_id                = {{.TypeId}}
  group_id               = {{.GroupId}}
  network_integration_id = {{.NetworkIntegrationId}}

  config_nsx_gateway_tier0 = {
    ha_mode      = "ACTIVE_ACTIVE"
    ip_server_id = {{.IpServerId}}
    restart_mode = "HELPER_ONLY"
  }
}
