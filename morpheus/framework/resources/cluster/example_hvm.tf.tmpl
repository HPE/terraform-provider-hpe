resource "hpe_morpheus_cluster" "example_hvm" {
  name              = "{{.Name}}"
  description       = "{{.Description}}"
  cloud_id          = {{.CloudId}}
  group_id          = {{.GroupId}}
  layout_id         = {{.LayoutId}}

  labels = [
    "{{.Label1}}",
    "{{.Label2}}",
  ]

  config_hvm = {
    create_user = {{.CreateUser}}
    dynamic_placement = {{.DynamicPlacement}}
    cpu_arch = "{{.CpuArch}}"
    cpu_model = "{{.CpuModel}}"
    power_policy = "{{.PowerPolicy}}"

    # HVM 2.0 network configuration. Only honoured when the selected cluster
    # layout has clusterVersion 2.0 or greater; otherwise Morpheus silently
    # drops these fields.
    virt_switch_name = "vSwitch0"
    dns1             = "8.8.8.8"
    dns2             = "8.8.4.4"
    dns3             = "1.1.1.1"
    search_domain    = "example.com"
    ntp1             = "0.pool.ntp.org"
    ntp2             = "1.pool.ntp.org"
    proxy            = "http://proxy.example.com:3128"
    no_proxy         = "localhost,127.0.0.1,.example.com"
  }

  server = {
    service_plan_id = {{.ServicePlanId}}

    ssh_port = {{.SshPort}}
    ssh_username = "{{.SshUsername}}"
    ssh_key_pair_id = {{.SshKeyPairId}}
    management_net_interface = "{{.ManagementNetInterface}}"

    ssh_hosts = [
      {
        name = "{{.SshHost1Name}}"
        ip = "{{.SshHost1Ip}}"
      },
      {
        name = "{{.SshHost2Name}}"
        ip = "{{.SshHost2Ip}}"
      },
      {
        name = "{{.SshHost3Name}}"
        ip = "{{.SshHost3Ip}}"
      }
    ]

    visibility = "{{.Visibility}}"

    tags = [
    {
      name = "{{.Tag1Name}}"
      value = "{{.Tag1Value}}"
    },
    {
      name = "{{.Tag2Name}}"
      value = "{{.Tag2Value}}"
    },
    ]
  }
}
