resource "hpe_morpheus_form" "example" {
  name        = "{{.Name}}"
  code        = "{{.Code}}"
  description = "{{.Description}}"
  labels      = {{.Labels}}

  option_type {
    name                          = "{{.OptionTypeName}}"
    code                          = "{{.OptionTypeCode}}"
    description                   = "{{.OptionTypeDescription}}"
    type                          = "{{.OptionTypeType}}"
    field_label                   = "{{.OptionTypeFieldLabel}}"
    field_name                    = "{{.OptionTypeFieldName}}"
    default_value                 = {{.OptionTypeDefaultValue}}
    help_block                    = "{{.OptionTypeHelpBlock}}"
    required                      = {{.OptionTypeRequired}}
    export_meta                   = {{.OptionTypeExportMeta}}
    display_value_on_details      = {{.OptionTypeDisplayValueOnDetails}}
    locked                        = {{.OptionTypeLocked}}
    hidden                        = {{.OptionTypeHidden}}
    exclude_from_search           = {{.OptionTypeExcludeFromSearch}}
    group_field_type              = "{{.OptionTypeGroupFieldType}}"
    group_id                      = "{{.OptionTypeGroupId}}"
    cloud_field_type              = "{{.OptionTypeCloudFieldType}}"
    cloud_id                      = "{{.OptionTypeCloudId}}"
    plan_field_type               = "{{.OptionTypePlanFieldType}}"
    plan_id                       = "{{.OptionTypePlanId}}"
    layout_field_type             = "{{.OptionTypeLayoutFieldType}}"
    layout_id                     = "{{.OptionTypeLayoutId}}"
    pool_field_type               = "{{.OptionTypePoolFieldType}}"
    pool_id                       = "{{.OptionTypePoolId}}"
    virtual_image_field_type      = "{{.OptionTypeVirtualImageFieldType}}"
    image_id                      = "{{.OptionTypeImageId}}"
    enable_disk_type_selection    = {{.OptionTypeEnableDiskTypeSelection}}
    enable_storage_type_selection = {{.OptionTypeEnableStorageTypeSelection}}
    enable_datastore_selection    = {{.OptionTypeEnableDatastoreSelection}}
  }
}
