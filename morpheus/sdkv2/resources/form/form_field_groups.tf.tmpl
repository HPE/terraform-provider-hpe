resource "hpe_morpheus_form" "example" {
  name        = "{{.Name}}"
  code        = "{{.Code}}"
  description = "{{.Description}}"
  labels      = {{.Labels}}

  field_group {
    name                 = "{{.FieldGroup1Name}}"
    description          = "{{.FieldGroup1Description}}"
    collapsible          = {{.FieldGroup1Collapsible}}
    collapsed_by_default = {{.FieldGroup1CollapsedByDefault}}
    option_type {
      name                     = "{{.FieldGroup1OptionTypeName}}"
      code                     = "{{.FieldGroup1OptionTypeCode}}"
      description              = "{{.FieldGroup1OptionTypeDescription}}"
      type                     = "{{.FieldGroup1OptionTypeType}}"
      field_label              = "{{.FieldGroup1OptionTypeFieldLabel}}"
      field_name               = "{{.FieldGroup1OptionTypeFieldName}}"
      default_value            = "{{.FieldGroup1OptionTypeDefaultValue}}"
      placeholder              = "{{.FieldGroup1OptionTypePlaceholder}}"
      help_block               = "{{.FieldGroup1OptionTypeHelpBlock}}"
      required                 = {{.FieldGroup1OptionTypeRequired}}
      export_meta              = {{.FieldGroup1OptionTypeExportMeta}}
      display_value_on_details = {{.FieldGroup1OptionTypeDisplayValueOnDetails}}
      locked                   = {{.FieldGroup1OptionTypeLocked}}
      hidden                   = {{.FieldGroup1OptionTypeHidden}}
      exclude_from_search      = {{.FieldGroup1OptionTypeExcludeFromSearch}}
    }
  }

  field_group {
    name                 = "{{.FieldGroup2Name}}"
    description          = "{{.FieldGroup2Description}}"
    collapsible          = {{.FieldGroup2Collapsible}}
    collapsed_by_default = {{.FieldGroup2CollapsedByDefault}}
    option_type {
      name                     = "{{.FieldGroup2OptionTypeName}}"
      code                     = "{{.FieldGroup2OptionTypeCode}}"
      description              = "{{.FieldGroup2OptionTypeDescription}}"
      type                     = "{{.FieldGroup2OptionTypeType}}"
      field_label              = "{{.FieldGroup2OptionTypeFieldLabel}}"
      field_name               = "{{.FieldGroup2OptionTypeFieldName}}"
      default_value            = "{{.FieldGroup2OptionTypeDefaultValue}}"
      placeholder              = "{{.FieldGroup2OptionTypePlaceholder}}"
      help_block               = "{{.FieldGroup2OptionTypeHelpBlock}}"
      required                 = {{.FieldGroup2OptionTypeRequired}}
      export_meta              = {{.FieldGroup2OptionTypeExportMeta}}
      display_value_on_details = {{.FieldGroup2OptionTypeDisplayValueOnDetails}}
      locked                   = {{.FieldGroup2OptionTypeLocked}}
      hidden                   = {{.FieldGroup2OptionTypeHidden}}
      exclude_from_search      = {{.FieldGroup2OptionTypeExcludeFromSearch}}
    }
  }
}
