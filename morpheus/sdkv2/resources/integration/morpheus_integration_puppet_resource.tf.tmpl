resource "hpe_morpheus_integration_puppet" "tf_example_puppet_integration" {
  name                       = "{{.Name}}"
  enabled                    = {{.Enabled}}
  puppet_master_hostname     = "{{.PuppetMasterHostname}}"
  allow_immediate_execution  = {{.AllowImmediateExecution}}
  puppet_master_ssh_username = "{{.PuppetMasterSshUsername}}"
  puppet_master_ssh_password = "{{.PuppetMasterSshPassword}}"
}
