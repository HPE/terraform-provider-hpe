resource "hpe_morpheus_task_write_attributes" "{{.Name}}" {
  name                = "{{.Name}}"
  code                = "{{.Code}}"
  labels              = ["{{.Label1}}", "{{.Label2}}"]
  attributes          = <<EOF
{{.Attributes}}
EOF
  retryable           = {{.Retryable}}
  retry_count         = {{.RetryCount}}
  retry_delay_seconds = {{.RetryDelaySeconds}}
  allow_custom_config = {{.AllowCustomConfig}}
}
